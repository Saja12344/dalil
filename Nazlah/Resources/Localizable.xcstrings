    "state.error.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاول مرة ثانية. إذا كنت بدون نت، بعض البيانات المحفوظة قد تظهر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again. Offline, cached public data may still appear."
          }
        }
      }
    },
    "state.retry": {
      "localizations": {
        "ar": {
