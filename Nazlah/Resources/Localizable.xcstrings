    "location.reason": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نستخدم الموقع مرة واحدة لترتيب المحطات القريبة. لا نتتبّع تنقّلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We use location once to rank nearby stations. We do not track your movement."
          }
        }
      }
    },
    "location.denied": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذن الموقع مرفوض. يمكنك تفعيله من الإعدادات."
