          "stringUnit": {
            "state": "translated",
            "value": "راسل الدعم من خلال نموذج البلاغ داخل التطبيق، أو عبر فريق حواليك عند توفر قناة عامة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact support through in-app reports, or through Hawaleek’s public channel when published."
          }
        }
      }
    },
