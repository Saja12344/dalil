{
  "sourceLanguage": "ar",
  "strings": {
    "app.name": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دليل"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalil"
          }
        }
      }
    },
    "app.tagline": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انزل المحطة، واتبع دليلك لوجهتك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit the station, then follow Dalil to your place"
          }
        }
      }
    },
    "tab.home": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرئيسية"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home"
          }
        }
      }
    },
    "tab.metro": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المترو"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Metro"
          }
        }
      }
    },
    "tab.map": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخريطة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map"
          }
        }
      }
    },
    "tab.favorites": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحفوظات"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved"
          }
        }
      }
    },
    "tab.account": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المزيد"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More"
          }
        }
      }
    },
    "onboarding.1.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتشف الأماكن قرب المحطات"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discover places by the metro"
          }
        }
      }
    },
    "onboarding.1.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطاعم ومقاهي وجلسات مرتبطة بمحطات مترو الرياض، مو تطبيق ملاحة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cafes, restaurants, and sittings tied to Riyadh Metro — not a navigation app."
          }
        }
      }
    },
    "onboarding.2.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرف المحطة والمخرج الأقرب"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know the station and the nearest exit"
          }
        }
      }
    },
    "onboarding.2.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نظهر المخرج فقط إذا كانت بياناته موثّقة. غير كذا نوضح أن التحديث جارٍ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We show an exit only when it is verified. Otherwise we say the data is still being updated."
          }
        }
      }
    },
    "onboarding.3.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعد المجتمع بإضافة الناقص"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help by adding what is missing"
          }
        }
      }
    },
    "onboarding.3.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مكانًا، وفريق الدعم يراجعه قبل ما يظهر للجميع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit a place. Support reviews it before it goes live."
          }
        }
      }
    },
    "onboarding.next": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التالي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        }
      }
    },
    "onboarding.start": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        }
      }
    },
    "home.greeting": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وين ودك تنزل؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where are you getting off?"
          }
        }
      }
    },
    "home.greeting.sub": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أماكن حول مترو الرياض، مرتبة حسب المشي لا الخط المستقيم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Places around Riyadh Metro, ranked by walking — not a straight line."
          }
        }
      }
    },
    "home.search.placeholder": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وين ودك تروح؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where do you want to go?"
          }
        }
      }
    },
